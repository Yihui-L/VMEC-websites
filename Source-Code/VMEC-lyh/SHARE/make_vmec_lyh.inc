SHELL = /bin/sh
PWD1 = `pwd`
FC = gfortran
CC = gcc
PRECOMP := /lib/cpp -traditional -DLINUX -DVMEC_OPENMP -DVMEC_OPENBLAS -DVMEC_GNU_FILE_IDENTITY -DVMEC_LINUX_STATX
COMPILE = $(FC)
COMPILE_FREE = $(FC) -ffree-form -ffree-line-length-none -ffixed-line-length-none
LINK = $(FC) $(FLAGS) -o
LINK_AR = ar -ruv
LINK_C = $(CC) -shared -Wl,-z,defs
FLAGS_R = -O3 -fopenmp -fbacktrace -fallow-argument-mismatch
FLAGS_D = -fopenmp -g -O0 -fbacktrace -fcheck=all -fallow-argument-mismatch
LIBS = -lopenblas -lscalapack-openmpi
LMPI = T
MPI_COMPILE = mpifort
MPI_COMPILE_FREE = mpifort -ffree-form -ffree-line-length-none -ffixed-line-length-none
MPI_COMPILE_C = mpicc
MPI_LINK = mpifort
MPI_RUN = mpiexec
MPI_RUN_OPTS = -n 2
LNAG = F
LNETCDF = T
NETCDF_INC = $(shell nf-config --fflags)
NETCDF_LIB = $(shell nf-config --flibs)
LNTCC = F
LHDF5 = F
LPGPLOT = F
LSILO = F
LFFTW3 = F
LDKES = F
LNEO = F
LIB_SHARE = -lc -lgfortran -lstdc++ -lmpi -lmpi_mpifh -lz -lm -lpthread $(LIBS)
